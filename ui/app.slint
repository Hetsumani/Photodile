export struct FilmstripItem {
    index: int,
    filename: string,
    thumbnail: image,
    has_thumbnail: bool,
}

export struct ExifEntry {
    label: string,
    value: string,
    is_header: bool,
}

component IconButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> icon-size: 14px;
    callback clicked();

    horizontal-stretch: 0;
    vertical-stretch: 0;
    min-height: 26px;
    border-radius: 4px;
    background: !root.enabled ? #18181b : touch.pressed ? #3f3f46 : (touch.has-hover || root.active) ? #27272a : #18181b;
    border-width: 1px;
    border-color: root.active ? #3b82f6 : (touch.has-hover ? #3f3f46 : #27272a);

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.text;
            color: !root.enabled ? #71717a : root.active ? #60a5fa : #e4e4e7;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component FormatBadge inherits Rectangle {
    in property <string> text: "";
    in property <color> badge-color: #3b82f6;

    height: 18px;
    border-radius: 3px;
    background: root.badge-color.transparentize(80%);
    border-width: 1px;
    border-color: root.badge-color.transparentize(50%);

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 700;
            color: root.badge-color;
            vertical-alignment: center;
        }
    }
}

component MenuBarButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> open: false;
    callback clicked();

    height: 24px;
    border-radius: 4px;
    background: root.open ? #2a2a2e : touch.pressed ? #3f3f46 : touch.has-hover ? #222225 : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: root.open ? #ffffff : #e4e4e7;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text: "";
    in property <string> shortcut: "";
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <bool> has-check: false;
    callback clicked();

    height: 28px;
    border-radius: 4px;
    background: !root.enabled ? transparent : touch.pressed ? #3f3f46 : touch.has-hover ? #2a2a2f : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;

        if root.has-check: Text {
            text: root.checked ? "✓" : "";
            color: #3b82f6;
            font-size: 11px;
            font-weight: 700;
            width: 14px;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            color: !root.enabled ? #52525b : #f4f4f5;
            font-size: 12px;
            font-weight: 500;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        if root.shortcut != "": Text {
            text: root.shortcut;
            color: !root.enabled ? #3f3f46 : #71717a;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component MenuSeparator inherits Rectangle {
    height: 1px;
    background: #27272a;
}

component WindowControlButton inherits Rectangle {
    in property <int> icon-type: 1; // 1 = Minimize, 2 = Maximize/Restore, 3 = Close
    in property <bool> is-maximized: false;
    in property <bool> is-close: false;
    callback clicked();

    width: 46px;
    height: 40px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: touch.pressed ? (root.is-close ? #c42b1c : #3f3f46) : touch.has-hover ? (root.is-close ? #e81123 : #27272a) : transparent;

    property <color> icon-color: (touch.has-hover && root.is-close) ? #ffffff : touch.has-hover ? #f4f4f5 : #a1a1aa;

    // Minimize Icon (horizontal line)
    if root.icon-type == 1: Rectangle {
        width: 10px;
        height: 1.2px;
        background: root.icon-color;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // Maximize Icon (single square)
    if root.icon-type == 2 && !root.is-maximized: Rectangle {
        width: 10px;
        height: 10px;
        background: transparent;
        border-width: 1.2px;
        border-color: root.icon-color;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // Restore Icon (two overlapping squares)
    if root.icon-type == 2 && root.is-maximized: Rectangle {
        width: 11px;
        height: 11px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Back square
        Rectangle {
            x: 2px;
            y: 0px;
            width: 9px;
            height: 9px;
            background: transparent;
            border-width: 1.2px;
            border-color: root.icon-color;
        }

        // Front square
        Rectangle {
            x: 0px;
            y: 2px;
            width: 9px;
            height: 9px;
            background: root.background;
            border-width: 1.2px;
            border-color: root.icon-color;
        }
    }

    // Close Icon (crisp vector X)
    if root.icon-type == 3: Path {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: root.icon-color;
        stroke-width: 1.3px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component FilmstripArrowButton inherits Rectangle {
    in property <bool> is-left: true;
    in property <bool> enabled: true;
    callback clicked();

    width: 32px;
    height: 90px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    background: !root.enabled ? #18181b : touch.pressed ? #3f3f46 : touch.has-hover ? #27272a : #18181b;
    border-width: 1px;
    border-color: touch.has-hover ? #3f3f46 : #27272a;

    property <color> chevron-color: !root.enabled ? #52525b : touch.has-hover ? #60a5fa : #d4d4d8;

    if root.is-left: Path {
        width: 7px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 7 0 L 0 6 L 7 12";
        stroke: root.chevron-color;
        stroke-width: 1.8px;
    }

    if !root.is-left: Path {
        width: 7px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 0 0 L 7 6 L 0 12";
        stroke: root.chevron-color;
        stroke-width: 1.8px;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Photodile";
    icon: @image-url("../images/iconV04.png");
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 480px;
    background: #0f0f11;
    default-font-family: "Segoe UI, Inter, Roboto, sans-serif";

    // Window management
    in-out property <bool> is-window-maximized: false;
    callback window-drag();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    callback window-resize(int); // 1=N, 2=S, 3=E, 4=W, 5=NE, 6=NW, 7=SE, 8=SW

    // Application State Properties
    in-out property <image> current-image;
    in-out property <bool> has-image: false;
    in-out property <string> current-filename: "No photo open";
    in-out property <string> current-dimensions: "";
    in-out property <string> current-format: "";
    in-out property <string> current-file-size: "";
    in-out property <string> current-index-text: "";
    in-out property <string> app-version: "v0.3.0";

    // Loading & Progress Indicator
    in-out property <bool> is-loading: false;
    in-out property <float> loading-progress: 0.0;
    in-out property <string> loading-title: "Loading Photo...";
    in-out property <string> loading-stage: "";

    // Viewport transform
    in-out property <length> canvas-width: 800px;
    in-out property <length> canvas-height: 600px;
    out property <float> live-canvas-width: canvas-container.width / 1px;
    out property <float> live-canvas-height: canvas-container.height / 1px;

    in-out property <length> image-offset-x: 0px;
    in-out property <length> image-offset-y: 0px;
    in-out property <length> image-display-width: 0px;
    in-out property <length> image-display-height: 0px;
    in-out property <float> current-zoom: 1.0;
    in-out property <string> zoom-percentage-text: "100%";

    // Filmstrip properties
    in-out property <[FilmstripItem]> filmstrip-items: [];
    in-out property <int> active-index: -1;
    in-out property <bool> show-filmstrip: false;
    in-out property <length> filmstrip-viewport-width: 800px;
    in-out property <length> filmstrip-scroll-x: 0px;

    animate filmstrip-scroll-x { duration: 200ms; easing: ease-out; }

    changed active-index => {
        root.recenter-filmstrip();
    }

    public function recenter-filmstrip() {
        let total-w = root.filmstrip-items.length * 94px;
        let view-w = root.filmstrip-viewport-width;
        if (total-w <= view-w) {
            root.filmstrip-scroll-x = (view-w - total-w) * 0.5;
        } else {
            let item-center = (root.active-index * 94px) + 43px;
            let raw-x = (view-w * 0.5) - item-center;
            let min-x = view-w - total-w;
            if (raw-x > 0px) {
                root.filmstrip-scroll-x = 0px;
            } else if (raw-x < min-x) {
                root.filmstrip-scroll-x = min-x;
            } else {
                root.filmstrip-scroll-x = raw-x;
            }
        }
    }

    // Sidebar properties
    in-out property <bool> show-info: false;
    in-out property <[ExifEntry]> exif-entries: [];

    // Drag-and-drop overlay
    in-out property <bool> is-drag-hovered: false;

    // Menu state (0 = closed, 1 = File, 2 = View)
    in-out property <int> active-menu: 0;

    // Modal visibility properties
    in-out property <bool> show-convert-modal: false;
    in-out property <bool> show-about-modal: false;
    in-out property <int> selected-convert-format: 0; // 0=PNG, 1=JPEG, 2=WebP, 3=AVIF, 4=TIFF, 5=QOI, 6=BMP, 7=OpenEXR, 8=TGA
    in-out property <int> convert-quality: 90;

    // Keyboard state tracking
    in-out property <bool> space-held: false;
    in-out property <bool> ctrl-held: false;
    in-out property <bool> is-dragging-canvas: false;

    // Callbacks to Rust backend
    callback open-single-file();
    callback open-multi-files();
    callback open-folder();
    callback add-images();
    callback save-as();
    callback clear-session();
    callback open-convert-modal();
    callback confirm-convert(int, int); // format_index, quality
    callback close-convert-modal();
    callback open-about-modal();
    callback close-about-modal();
    callback open-url(string);
    callback zoom-in();
    callback zoom-out();
    callback zoom-fit();
    callback zoom-100();
    callback toggle-filmstrip();
    callback toggle-info();
    callback select-index(int);
    callback navigate-prev();
    callback navigate-next();

    public function set-thumbnail(index: int, thumb: image) {
        root.filmstrip-items[index].thumbnail = thumb;
        root.filmstrip-items[index].has_thumbnail = true;
    }

    // Canvas interactions
    callback canvas-pointer-down(float, float, int); // x, y, button (1=left, 2=right, 3=middle)
    callback canvas-pointer-move(float, float);
    callback canvas-pointer-up(float, float);
    callback canvas-scroll(float, float, float); // delta_y, mouse_x, mouse_y
    callback canvas-resized(float, float);

    // Keyboard callbacks
    callback key-pressed(string, bool, bool) -> bool; // text, ctrl, shift
    callback key-released(string);

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.space-held = true;
                return accept;
            }
            if (event.text == Key.Control) {
                root.ctrl-held = true;
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.navigate-prev();
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.navigate-next();
                return accept;
            }
            if (event.text == "0" || event.text == "f" || event.text == "F") {
                root.zoom-fit();
                return accept;
            }
            if (event.text == "1") {
                root.zoom-100();
                return accept;
            }
            if (event.text == "t" || event.text == "T") {
                root.toggle-filmstrip();
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                root.toggle-info();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.active-menu != 0) {
                    root.active-menu = 0;
                    return accept;
                }
                if (root.show-convert-modal) {
                    root.close-convert-modal();
                    return accept;
                }
                if (root.show-about-modal) {
                    root.show-about-modal = false;
                    return accept;
                }
            }
            return reject;
        }

        key-released(event) => {
            if (event.text == " ") {
                root.space-held = false;
                return accept;
            }
            if (event.text == Key.Control) {
                root.ctrl-held = false;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;

            // TOP UNIFIED BAR (VSCode style)
            Rectangle {
                height: 40px;
                background: #141416;
                z: 20;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #232326;
                }

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 0px;
                    spacing: 0px;

                    // Left Section: App Icon + File/View/Help Menus
                    Rectangle {
                        horizontal-stretch: 0;
                        width: 195px;
                        height: 40px;

                        HorizontalLayout {
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                            spacing: 6px;

                            Image {
                                width: 22px;
                                height: 22px;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../images/iconV04.png");
                                image-fit: contain;
                            }

                            // "File" Menu Button
                            file-btn := MenuBarButton {
                                text: "File";
                                open: root.active-menu == 1;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    root.active-menu = root.active-menu == 1 ? 0 : 1;
                                }
                            }

                            // "View" Menu Button
                            view-btn := MenuBarButton {
                                text: "View";
                                open: root.active-menu == 2;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    root.active-menu = root.active-menu == 2 ? 0 : 2;
                                }
                            }

                            // "Help" Menu Button
                            help-btn := MenuBarButton {
                                text: "Help";
                                open: root.active-menu == 3;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    root.active-menu = root.active-menu == 3 ? 0 : 3;
                                }
                            }
                        }
                    }

                    // Center Draggable Window Title Area
                    title-drag := Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;

                        Text {
                            text: root.has-image ? root.current-filename + " — Photodile" : "Photodile";
                            color: #a1a1aa;
                            font-size: 12px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.active-menu = 0;
                                    root.window-drag();
                                }
                            }
                            double-clicked => {
                                root.window-toggle-maximize();
                            }
                        }
                    }

                    // Right Section: Quick View Toggles + Window Controls
                    Rectangle {
                        horizontal-stretch: 0;
                        width: 280px;
                        height: 40px;

                        HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            spacing: 0px;
                            alignment: end;

                            HorizontalLayout {
                                spacing: 6px;
                                y: (parent.height - self.height) / 2;
                                padding-right: 10px;

                                IconButton {
                                    text: "Filmstrip";
                                    active: root.show-filmstrip;
                                    enabled: root.filmstrip-items.length > 0;
                                    clicked => { root.toggle-filmstrip(); }
                                }
                                IconButton {
                                    text: "Info";
                                    active: root.show-info;
                                    enabled: root.has-image;
                                    clicked => { root.toggle-info(); }
                                }
                            }

                            // Subtle Divider
                            Rectangle {
                                width: 1px;
                                height: 18px;
                                background: #27272a;
                                y: (parent.height - self.height) / 2;
                            }

                            // VSCode-style Vector Window Controls (Pinned to top-right corner)
                            WindowControlButton {
                                icon-type: 1;
                                clicked => { root.window-minimize(); }
                            }
                            WindowControlButton {
                                icon-type: 2;
                                is-maximized: root.is-window-maximized;
                                clicked => { root.window-toggle-maximize(); }
                            }
                            WindowControlButton {
                                icon-type: 3;
                                is-close: true;
                                clicked => { root.window-close(); }
                            }
                        }
                    }
                }
            }

            // MIDDLE AREA: Canvas + Optional Sidebar
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // MAIN INTERACTIVE CANVAS
                canvas-container := Rectangle {
                    horizontal-stretch: 1;
                    background: #09090b;
                    clip: true;

                    // Dynamically report live dimensions whenever container resizes
                    changed width => {
                        root.canvas-resized(self.width / 1px, self.height / 1px);
                    }
                    changed height => {
                        root.canvas-resized(self.width / 1px, self.height / 1px);
                    }

                    // Rendered Image
                    if root.has-image: Image {
                        x: root.image-offset-x;
                        y: root.image-offset-y;
                        width: root.image-display-width;
                        height: root.image-display-height;
                        source: root.current-image;
                        image-fit: fill;
                        image-rendering: root.current-zoom >= 4.0 ? pixelated : smooth;
                    }

                    // Interactive TouchArea for Mouse Pan / Scrubby Zoom / Scroll
                    canvas-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: root.has-image;
                        mouse-cursor: root.is-dragging-canvas ? (root.ctrl-held ? ew-resize : grabbing) : (root.space-held ? (root.ctrl-held ? ew-resize : grab) : default);

                        pointer-event(event) => {
                            if (root.active-menu != 0) {
                                root.active-menu = 0;
                            }
                            if (event.kind == PointerEventKind.down) {
                                root.canvas-pointer-down(self.mouse-x / 1px, self.mouse-y / 1px, 1);
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                root.canvas-pointer-up(self.mouse-x / 1px, self.mouse-y / 1px);
                            }
                        }

                        moved => {
                            root.canvas-pointer-move(self.mouse-x / 1px, self.mouse-y / 1px);
                        }

                        scroll-event(event) => {
                            root.canvas-scroll(event.delta-y / 1px, self.mouse-x / 1px, self.mouse-y / 1px);
                            return accept;
                        }
                    }

                    // Empty State Prompt
                    if !root.has-image: Rectangle {
                        width: 100%;
                        height: 100%;
                        z: 10;
                        VerticalLayout {
                            alignment: center;
                            spacing: 14px;

                            Image {
                                width: 88px;
                                height: 88px;
                                source: @image-url("../images/iconV04.png");
                                image-fit: contain;
                                x: (parent.width - self.width) / 2;
                            }

                            Text {
                                text: "No Photo Open";
                                font-size: 16px;
                                font-weight: 600;
                                color: #f4f4f5;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Click 'File > Open File' or drag & drop photos here";
                                font-size: 13px;
                                color: #a1a1aa;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding-top: 8px;

                                IconButton { text: "Open File"; clicked => { root.open-single-file(); } }
                                IconButton { text: "Open Folder"; clicked => { root.open-folder(); } }
                            }
                        }
                    }

                    // OS File Drag & Drop Overlay
                    if root.is-drag-hovered: Rectangle {
                        width: 100%;
                        height: 100%;
                        background: #1d4ed833;
                        border-width: 2px;
                        border-color: #3b82f6;

                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;

                            Text {
                                text: "Drop Photos or Folder Here (Appends to Filmstrip)";
                                font-size: 18px;
                                font-weight: 700;
                                color: #93c5fd;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Loading & Progress Overlay (Centered Floating Card)
                    if root.is-loading: Rectangle {
                        width: 100%;
                        height: 100%;
                        background: #09090bcc;
                        z: 30;

                        // Click interceptor so clicking while loading doesn't trigger canvas gestures
                        TouchArea {
                            width: 100%;
                            height: 100%;
                        }

                        // Floating Card
                        Rectangle {
                            width: 380px;
                            height: 110px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            background: #18181b;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #2e2e33;
                            drop-shadow-blur: 24px;
                            drop-shadow-color: #000000bb;

                            VerticalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                padding-top: 16px;
                                padding-bottom: 16px;
                                spacing: 10px;
                                alignment: center;

                                // Header row: Filename & Percentage
                                HorizontalLayout {
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.loading-title;
                                        color: #f4f4f5;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 0;
                                        text: Math.round(root.loading-progress * 100) + "%";
                                        color: #60a5fa;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                // Progress track & animated fill bar
                                Rectangle {
                                    width: 100%;
                                    height: 6px;
                                    background: #27272a;
                                    border-radius: 3px;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 100%;
                                        width: parent.width * Math.min(1.0, Math.max(0.02, root.loading-progress));
                                        background: #3b82f6;
                                        border-radius: 3px;
                                        animate width { duration: 150ms; easing: ease-out; }
                                    }
                                }

                                // Stage Description
                                Text {
                                    text: root.loading-stage != "" ? root.loading-stage : "Please wait...";
                                    color: #a1a1aa;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    init => {
                        root.canvas-resized(self.width / 1px, self.height / 1px);
                    }
                }

                // COLLAPSIBLE EXIF & METADATA SIDEBAR
                if root.show-info: Rectangle {
                    width: 280px;
                    background: #141416;

                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: 100%;
                        background: #27272a;
                    }

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        // Compact Header (only covers text & close button height)
                        Rectangle {
                            height: 26px;
                            vertical-stretch: 0;

                            Text {
                                x: 0px;
                                width: parent.width - 32px;
                                height: 100%;
                                text: "Photo Details & EXIF";
                                font-size: 13px;
                                font-weight: 700;
                                color: #f4f4f5;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            IconButton {
                                x: parent.width - self.width;
                                y: 0px;
                                width: 26px;
                                height: 26px;
                                text: "✕";
                                clicked => { root.toggle-info(); }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            vertical-stretch: 0;
                            background: #27272a;
                        }

                        Flickable {
                            vertical-stretch: 1;
                            content-width: self.width;

                            VerticalLayout {
                                width: 100%;
                                alignment: start;
                                spacing: 8px;
                                padding-top: 2px;
                                padding-bottom: 16px;

                                for entry in root.exif-entries: VerticalLayout {
                                    width: 100%;

                                    if entry.is_header: VerticalLayout {
                                        padding-top: 8px;
                                        padding-bottom: 2px;
                                        spacing: 5px;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;

                                            Rectangle {
                                                width: 3px;
                                                height: 12px;
                                                background: #3b82f6;
                                                border-radius: 1px;
                                            }

                                            Text {
                                                text: entry.label;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #60a5fa;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            height: 1px;
                                            background: #27272a;
                                        }
                                    }

                                    if !entry.is_header: HorizontalLayout {
                                        width: 100%;
                                        spacing: 10px;
                                        alignment: space-between;

                                        Text {
                                            width: 90px;
                                            horizontal-stretch: 0;
                                            text: entry.label;
                                            color: #a1a1aa;
                                            font-size: 11px;
                                            font-weight: 500;
                                            vertical-alignment: top;
                                        }

                                        Text {
                                            horizontal-stretch: 1;
                                            text: entry.value;
                                            color: #f4f4f5;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: right;
                                            vertical-alignment: top;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // BOTTOM FILMSTRIP
            if root.show-filmstrip: Rectangle {
                height: 108px;
                background: #141416;

                Rectangle {
                    y: 0px;
                    width: 100%;
                    height: 1px;
                    background: #27272a;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;

                    // Fixed-width Left Prev Button pinned to left
                    FilmstripArrowButton {
                        is-left: true;
                        enabled: root.active-index > 0;
                        clicked => { root.navigate-prev(); }
                    }

                    // Filmstrip Thumbnails Viewport with Auto-Centering and Mouse Wheel Scroll
                    filmstrip-viewport := Rectangle {
                        horizontal-stretch: 1;
                        height: 90px;
                        clip: true;

                        changed width => {
                            root.filmstrip-viewport-width = self.width;
                            root.recenter-filmstrip();
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;

                            scroll-event(event) => {
                                let total-w = root.filmstrip-items.length * 94px;
                                let view-w = root.filmstrip-viewport-width;
                                if (total-w > view-w) {
                                    let min-x = view-w - total-w;
                                    let delta = event.delta-y;
                                    let target-x = root.filmstrip-scroll-x + delta;
                                    if (target-x > 0px) {
                                        root.filmstrip-scroll-x = 0px;
                                    } else if (target-x < min-x) {
                                        root.filmstrip-scroll-x = min-x;
                                    } else {
                                        root.filmstrip-scroll-x = target-x;
                                    }
                                }
                                return accept;
                            }
                        }

                        HorizontalLayout {
                            x: root.filmstrip-scroll-x;
                            y: 0px;
                            width: root.filmstrip-items.length * 94px;
                            height: 90px;
                            spacing: 8px;

                            for item in root.filmstrip-items: Rectangle {
                                width: 86px;
                                height: 90px;
                                border-radius: 4px;
                                background: item.index == root.active-index ? #1e293b : #18181b;
                                border-width: item.index == root.active-index ? 2px : 1px;
                                border-color: item.index == root.active-index ? #3b82f6 : #27272a;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 4px;

                                    Rectangle {
                                        width: 78px;
                                        height: 58px;
                                        border-radius: 2px;
                                        background: #09090b;
                                        clip: true;

                                        if item.has_thumbnail: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: item.thumbnail;
                                            image-fit: contain;
                                        }

                                        if !item.has_thumbnail: Text {
                                            text: "Loading...";
                                            font-size: 9px;
                                            color: #71717a;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: item.filename;
                                        font-size: 10px;
                                        color: item.index == root.active-index ? #93c5fd : #a1a1aa;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-index(item.index); }
                                }
                            }
                        }
                    }

                    // Fixed-width Right Next Button pinned to right
                    FilmstripArrowButton {
                        is-left: false;
                        enabled: root.active-index < root.filmstrip-items.length - 1;
                        clicked => { root.navigate-next(); }
                    }
                }
            }

            // BOTTOM BAR (WITH ZOOM CONTROLS IN THE BOTTOM-LEFT CORNER)
            Rectangle {
                height: 34px;
                background: #111113;

                Rectangle {
                    y: 0px;
                    width: 100%;
                    height: 1px;
                    background: #1f1f23;
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 12px;
                    spacing: 8px;

                    // ZOOM OPTIONS IN BOTTOM-LEFT CORNER
                    IconButton { text: "−"; enabled: root.has-image; clicked => { root.zoom-out(); } }
                    Rectangle {
                        width: 50px;
                        height: 26px;
                        background: #18181b;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #27272a;
                        Text {
                            text: root.zoom-percentage-text;
                            color: #60a5fa;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    IconButton { text: "+"; enabled: root.has-image; clicked => { root.zoom-in(); } }
                    IconButton { text: "Fit (0)"; enabled: root.has-image; clicked => { root.zoom-fit(); } }
                    IconButton { text: "100% (1)"; enabled: root.has-image; clicked => { root.zoom-100(); } }

                    // Separator
                    Rectangle { width: 1px; height: 16px; background: #27272a; y: 9px; }

                    // Photo Info Details
                    if root.current-index-text != "": Text {
                        text: root.current-index-text;
                        color: #71717a;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.current-filename;
                        color: #d4d4d8;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    if root.current-format != "": FormatBadge {
                        text: root.current-format;
                        y: 8px;
                    }

                    if root.current-dimensions != "": Text {
                        text: root.current-dimensions;
                        color: #a1a1aa;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    if root.current-file-size != "": Text {
                        text: root.current-file-size;
                        color: #71717a;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    // Spacer
                    Rectangle { horizontal-stretch: 1; }

                    // Navigation & Tool Hints
                    Text {
                        text: "Space+Drag: Pan | Space+Ctrl+Drag: Scrubby Zoom | Scroll: Zoom | Arrows: Prev/Next";
                        color: #52525b;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // CLICK-OUTSIDE DISMISSAL FOR POPUP MENUS
        if root.active-menu != 0: TouchArea {
            width: 100%;
            height: 100%;
            z: 90;
            clicked => { root.active-menu = 0; }
        }

        // "FILE" POPUP DROPDOWN MENU
        if root.active-menu == 1: Rectangle {
            x: 48px;
            y: 40px;
            width: 220px;
            height: self.preferred-height;
            z: 100;
            background: #18181b;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2e2e33;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                MenuItem { text: "Open File..."; shortcut: "Ctrl+O"; clicked => { root.active-menu = 0; root.open-single-file(); } }
                MenuItem { text: "Open Multiple Files..."; shortcut: "Ctrl+Shift+O"; clicked => { root.active-menu = 0; root.open-multi-files(); } }
                MenuItem { text: "Open Folder..."; shortcut: "Ctrl+K"; clicked => { root.active-menu = 0; root.open-folder(); } }
                MenuItem { text: "Add Images to Session..."; enabled: root.has-image; clicked => { root.active-menu = 0; root.add-images(); } }
                MenuSeparator {}
                MenuItem { text: "Save As..."; shortcut: "Ctrl+S"; enabled: root.has-image; clicked => { root.active-menu = 0; root.save-as(); } }
                MenuItem { text: "Convert to..."; shortcut: "Ctrl+E"; enabled: root.has-image; clicked => { root.active-menu = 0; root.open-convert-modal(); } }
                MenuSeparator {}
                MenuItem { text: "Clear Session"; enabled: root.has-image; clicked => { root.active-menu = 0; root.clear-session(); } }
            }
        }

        // "VIEW" POPUP DROPDOWN MENU
        if root.active-menu == 2: Rectangle {
            x: 94px;
            y: 40px;
            width: 210px;
            height: self.preferred-height;
            z: 100;
            background: #18181b;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2e2e33;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                MenuItem { text: "Fit to View"; shortcut: "0 / F"; enabled: root.has-image; clicked => { root.active-menu = 0; root.zoom-fit(); } }
                MenuItem { text: "Actual Size (100%)"; shortcut: "1"; enabled: root.has-image; clicked => { root.active-menu = 0; root.zoom-100(); } }
                MenuItem { text: "Zoom In"; shortcut: "+"; enabled: root.has-image; clicked => { root.active-menu = 0; root.zoom-in(); } }
                MenuItem { text: "Zoom Out"; shortcut: "-"; enabled: root.has-image; clicked => { root.active-menu = 0; root.zoom-out(); } }
                MenuSeparator {}
                MenuItem { text: "Filmstrip"; shortcut: "T"; has-check: true; checked: root.show-filmstrip; enabled: root.filmstrip-items.length > 0; clicked => { root.active-menu = 0; root.toggle-filmstrip(); } }
                MenuItem { text: "Photo Details & EXIF"; shortcut: "I"; has-check: true; checked: root.show-info; enabled: root.has-image; clicked => { root.active-menu = 0; root.toggle-info(); } }
            }
        }

        // "HELP" POPUP DROPDOWN MENU
        if root.active-menu == 3: Rectangle {
            x: 144px;
            y: 40px;
            width: 160px;
            height: self.preferred-height;
            z: 100;
            background: #18181b;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2e2e33;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                MenuItem {
                    text: "About";
                    clicked => {
                        root.active-menu = 0;
                        root.show-about-modal = true;
                    }
                }
            }
        }

        // "CONVERT TO..." IN-APP MODAL
        if root.show-convert-modal: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000bb;
            z: 150;

            // Modal Box
            Rectangle {
                width: 440px;
                height: 380px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #18181b;
                border-radius: 8px;
                border-width: 1px;
                border-color: #27272a;
                drop-shadow-blur: 24px;
                drop-shadow-color: #000000aa;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    // Header
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Convert Image";
                            font-size: 16px;
                            font-weight: 700;
                            color: #f4f4f5;
                            vertical-alignment: center;
                        }
                        IconButton {
                            text: "✕";
                            clicked => { root.close-convert-modal(); }
                        }
                    }

                    Rectangle { height: 1px; background: #27272a; }

                    // Format Selection
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Target Format:";
                            color: #a1a1aa;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            IconButton { text: "PNG"; active: root.selected-convert-format == 0; clicked => { root.selected-convert-format = 0; } }
                            IconButton { text: "JPEG"; active: root.selected-convert-format == 1; clicked => { root.selected-convert-format = 1; } }
                            IconButton { text: "WebP"; active: root.selected-convert-format == 2; clicked => { root.selected-convert-format = 2; } }
                            IconButton { text: "AVIF"; active: root.selected-convert-format == 3; clicked => { root.selected-convert-format = 3; } }
                            IconButton { text: "TIFF"; active: root.selected-convert-format == 4; clicked => { root.selected-convert-format = 4; } }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            IconButton { text: "QOI"; active: root.selected-convert-format == 5; clicked => { root.selected-convert-format = 5; } }
                            IconButton { text: "BMP"; active: root.selected-convert-format == 6; clicked => { root.selected-convert-format = 6; } }
                            IconButton { text: "OpenEXR"; active: root.selected-convert-format == 7; clicked => { root.selected-convert-format = 7; } }
                            IconButton { text: "TGA"; active: root.selected-convert-format == 8; clicked => { root.selected-convert-format = 8; } }
                        }
                    }

                    // Quality Control (JPEG & AVIF)
                    if root.selected-convert-format == 1 || root.selected-convert-format == 3: VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Export Quality:";
                                color: #a1a1aa;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.convert-quality + "%";
                                color: #3b82f6;
                                font-size: 12px;
                                font-weight: 700;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            IconButton { text: "75%"; clicked => { root.convert-quality = 75; } }
                            IconButton { text: "85%"; clicked => { root.convert-quality = 85; } }
                            IconButton { text: "92%"; clicked => { root.convert-quality = 92; } }
                            IconButton { text: "98%"; clicked => { root.convert-quality = 98; } }
                            IconButton { text: "100%"; clicked => { root.convert-quality = 100; } }
                        }
                    }

                    // Image summary info
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Source: " + root.current-filename;
                            color: #71717a;
                            font-size: 11px;
                        }
                        Text {
                            text: "Resolution: " + root.current-dimensions;
                            color: #71717a;
                            font-size: 11px;
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    // Modal Buttons
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;

                        IconButton {
                            text: "Cancel";
                            clicked => { root.close-convert-modal(); }
                        }

                        IconButton {
                            text: "Convert & Save...";
                            active: true;
                            clicked => { root.confirm-convert(root.selected-convert-format, root.convert-quality); }
                        }
                    }
                }
            }
        }

        // "ABOUT PHOTODILE" SPLASH SCREEN MODAL
        if root.show-about-modal: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000bb;
            z: 150;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.show-about-modal = false; }
            }

            Rectangle {
                width: 480px;
                height: self.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #18181b;
                border-radius: 12px;
                border-width: 1px;
                border-color: #27272a;
                drop-shadow-blur: 32px;
                drop-shadow-color: #000000dd;

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    alignment: center;

                    // Header: Logo & Title
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            width: 72px;
                            height: 72px;
                            source: @image-url("../images/iconV04.png");
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: "Photodile";
                                font-size: 20px;
                                font-weight: 700;
                                color: #f4f4f5;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                height: 20px;
                                border-radius: 4px;
                                background: #27272a;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: root.app-version;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #60a5fa;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Developed by: Hetsumani S.A.S. with Antigravity";
                            font-size: 12px;
                            font-weight: 500;
                            color: #a1a1aa;
                            horizontal-alignment: center;
                        }
                    }

                    Rectangle { height: 1px; background: #27272a; }

                    // Thank You Notice
                    Text {
                        text: "Thank you for using Photodile! Built for photographers and visual creators who value speed, simplicity, and precision.";
                        font-size: 11px;
                        color: #d4d4d8;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    // Tech Stack & Slint Notice Box
                    Rectangle {
                        border-radius: 6px;
                        background: #131315;
                        border-width: 1px;
                        border-color: #27272a;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            Text {
                                text: "Built in 100% Pure Rust 🦀";
                                font-size: 11px;
                                font-weight: 600;
                                color: #f97316;
                                horizontal-alignment: center;
                            }

                            // Slint Attribution (Clickable)
                            Rectangle {
                                height: 24px;
                                border-radius: 4px;
                                background: slint-touch.has-hover ? #222226 : transparent;

                                Text {
                                    text: "GUI powered by Slint UI (slint.dev) ↗";
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: slint-touch.has-hover ? #60a5fa : #93c5fd;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                slint-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.open-url("https://slint.dev");
                                    }
                                }
                            }
                        }
                    }

                    // GitHub Repository Button (Clickable)
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: repo-touch.pressed ? #27272a : repo-touch.has-hover ? #242428 : #18181b;
                        border-width: 1px;
                        border-color: repo-touch.has-hover ? #3b82f6 : #2e2e33;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "Source Code on GitHub: github.com/Hetsumani/Photodile ↗";
                                font-size: 11px;
                                font-weight: 500;
                                color: repo-touch.has-hover ? #60a5fa : #e4e4e7;
                                vertical-alignment: center;
                            }
                        }

                        repo-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-url("https://github.com/Hetsumani/Photodile");
                            }
                        }
                    }

                    // License Notice
                    Text {
                        text: "Released under the MIT Open Source License\nCopyright © 2026 Hetsumani S.A.S.";
                        font-size: 10px;
                        color: #71717a;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    // Close Button
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 4px;

                        IconButton {
                            text: "Close";
                            clicked => { root.show-about-modal = false; }
                        }
                    }
                }
            }
        }

        // FRAMELESS WINDOW RESIZE HANDLES (Active when not maximized)
        if !root.is-window-maximized: TouchArea {
            // Top Edge
            x: 5px; y: 0px; width: parent.width - 10px; height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.window-resize(1); } }
        }
        if !root.is-window-maximized: TouchArea {
            // Bottom Edge
            x: 5px; y: parent.height - 5px; width: parent.width - 10px; height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.window-resize(2); } }
        }
        if !root.is-window-maximized: TouchArea {
            // Right Edge
            x: parent.width - 5px; y: 5px; width: 5px; height: parent.height - 10px;
            mouse-cursor: ew-resize;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.window-resize(3); } }
        }
        if !root.is-window-maximized: TouchArea {
            // Left Edge
            x: 0px; y: 5px; width: 5px; height: parent.height - 10px;
            mouse-cursor: ew-resize;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.window-resize(4); } }
        }
        if !root.is-window-maximized: TouchArea {
            // Top-Right Corner
            x: parent.width - 5px; y: 0px; width: 5px; height: 5px;
            mouse-cursor: nesw-resize;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.window-resize(5); } }
        }
        if !root.is-window-maximized: TouchArea {
            // Top-Left Corner
            x: 0px; y: 0px; width: 5px; height: 5px;
            mouse-cursor: nwse-resize;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.window-resize(6); } }
        }
        if !root.is-window-maximized: TouchArea {
            // Bottom-Right Corner
            x: parent.width - 5px; y: parent.height - 5px; width: 5px; height: 5px;
            mouse-cursor: nwse-resize;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.window-resize(7); } }
        }
        if !root.is-window-maximized: TouchArea {
            // Bottom-Left Corner
            x: 0px; y: parent.height - 5px; width: 5px; height: 5px;
            mouse-cursor: nesw-resize;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.window-resize(8); } }
        }
    }
}
